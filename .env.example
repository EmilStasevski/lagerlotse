# Copy to .env and fill in. Never commit .env.

# Claude API (needed for the agent and `task eval` only; data, tools, tests and report work without)
ANTHROPIC_API_KEY=
# Model ID for the agent, e.g. from https://docs.claude.com/en/docs/about-claude/models
LAGERLOTSE_MODEL=

# Owner connection: seed script and report job only
LAGERLOTSE_DATABASE_URL=postgresql+psycopg://lagerlotse:lagerlotse@localhost:5432/lagerlotse
# Read-only connection for agent and web app (password must match LAGERLOTSE_READER_PASSWORD)
LAGERLOTSE_READER_DATABASE_URL=postgresql+psycopg://lagerlotse_reader:lagerlotse_reader@localhost:5432/lagerlotse
LAGERLOTSE_READER_PASSWORD=lagerlotse_reader

# Seed for the synthetic data
LAGERLOTSE_SEED=42

# Tests use their own database in the same Postgres
LAGERLOTSE_TEST_DATABASE_URL=postgresql+psycopg://lagerlotse:lagerlotse@localhost:5432/lagerlotse_test
